<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.template.RaceController"
           prefWidth="860" prefHeight="620"
           style="-fx-background-color: #1e1e2e;">

    <!-- ══════════════ LOBBY PANE ══════════════ -->
    <VBox fx:id="lobbyPane"
          alignment="CENTER" spacing="20"
          style="-fx-padding: 40;">

        <Label text="TYPE RACER — Multiplayer"
               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #cdd6f4;"/>

        <Label text="Both players must be on the same machine (localhost)."
               style="-fx-text-fill: #a6adc8; -fx-font-size: 13px;"/>

        <HBox alignment="CENTER" spacing="20">
            <Button fx:id="hostButton" text="🖥  Host Race"
                    onAction="#handleHost"
                    prefWidth="160" prefHeight="48"
                    style="-fx-background-color: #89b4fa; -fx-text-fill: #1e1e2e;
                           -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 8;"/>

            <Button fx:id="joinButton" text="🔗  Join Race"
                    onAction="#handleJoin"
                    prefWidth="160" prefHeight="48"
                    style="-fx-background-color: #a6e3a1; -fx-text-fill: #1e1e2e;
                           -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 8;"/>
        </HBox>

        <Label fx:id="statusLabel" text="Choose Host or Join to begin."
               style="-fx-text-fill: #fab387; -fx-font-size: 13px;"/>

        <Button fx:id="backButton" text="← Back"
                onAction="#handleBack"
                style="-fx-background-color: #313244; -fx-text-fill: #cdd6f4;
                       -fx-font-size: 13px; -fx-background-radius: 6; -fx-padding: 6 16;"/>
    </VBox>

    <!-- ══════════════ RACE PANE ══════════════ -->
    <VBox fx:id="racePane"
          spacing="12"
          style="-fx-padding: 24;">

        <!-- Countdown overlay -->
        <StackPane>
            <Label fx:id="countdownLabel" text="3"
                   style="-fx-font-size: 72px; -fx-font-weight: bold;
                          -fx-text-fill: #f38ba8; -fx-effect: dropshadow(gaussian,#f38ba8,20,0,0,0);"/>
        </StackPane>

        <!-- ── YOU ── -->
        <VBox spacing="4" style="-fx-background-color: #313244; -fx-padding: 10; -fx-background-radius: 8;">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label fx:id="myProgressLabel" text="You: 0%"
                       style="-fx-text-fill: #89b4fa; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                <Label fx:id="myWpmLabel" text="WPM: 0"
                       style="-fx-text-fill: #a6e3a1; -fx-font-size: 13px;"/>
            </HBox>
            <ProgressBar fx:id="myProgressBar" progress="0"
                         prefWidth="800" prefHeight="14"
                         style="-fx-accent: #89b4fa;"/>
        </VBox>

        <!-- ── OPPONENT ── -->
        <VBox spacing="4" style="-fx-background-color: #313244; -fx-padding: 10; -fx-background-radius: 8;">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label fx:id="opponentProgressLabel" text="Opponent: 0%"
                       style="-fx-text-fill: #f38ba8; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                <Label fx:id="opponentWpmLabel" text="WPM: 0"
                       style="-fx-text-fill: #fab387; -fx-font-size: 13px;"/>
            </HBox>
            <ProgressBar fx:id="opponentProgressBar" progress="0"
                         prefWidth="800" prefHeight="14"
                         style="-fx-accent: #f38ba8;"/>
        </VBox>

        <!-- ── PARAGRAPH ── -->
        <ScrollPane fitToWidth="true" prefHeight="140"
                    style="-fx-background: #181825; -fx-background-color: #181825; -fx-background-radius: 8;">
            <TextFlow fx:id="typingBlock"
                      style="-fx-padding: 12; -fx-line-spacing: 4;"/>
        </ScrollPane>

        <!-- ── INPUT ── -->
        <TextArea fx:id="inputField"
                  promptText="Start typing here..."
                  prefHeight="60"
                  wrapText="true"
                  style="-fx-control-inner-background: #313244; -fx-text-fill: #cdd6f4;
                         -fx-font-size: 16px; -fx-background-radius: 8; -fx-font-family: monospace;
                         -fx-border-color: #585b70; -fx-border-radius: 8;"/>

        <!-- ── RESULT ── -->
        <Label fx:id="resultLabel" text=""
               wrapText="true"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #a6e3a1;"/>

        <Button text="← Leave Race" onAction="#handleBack"
                style="-fx-background-color: #45475a; -fx-text-fill: #cdd6f4;
                       -fx-font-size: 13px; -fx-background-radius: 6; -fx-padding: 6 16;"/>
    </VBox>

</StackPane>
