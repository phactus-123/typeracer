<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.TextFlow?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #1e1e2e;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.template.MainController">
   <children>

      <!-- ══════════ NAV BAR ══════════ -->
      <AnchorPane prefHeight="56.0" prefWidth="900.0" style="-fx-background-color: #181825; -fx-border-color: #313244; -fx-border-width: 0 0 1 0;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <!-- Logo icon -->
            <ImageView fitHeight="34.0" fitWidth="34.0" layoutX="14.0" layoutY="11.0" pickOnBounds="true" preserveRatio="true">
               <image><Image url="@../../Images/typing_17816535.png" /></image>
            </ImageView>

            <!-- Nav buttons -->
            <HBox layoutX="60.0" layoutY="0.0" prefHeight="56.0" spacing="4.0">
               <children>
                  <Button fx:id="button" mnemonicParsing="false" prefHeight="56.0" prefWidth="120.0" style="-fx-background-color: transparent; -fx-text-fill: #cdd6f4; -fx-font-size: 13px; -fx-font-family: 'Segoe UI';" text="Dashboard">
                     <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image><Image url="@../../Images/Home.png" /></image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="button" mnemonicParsing="false" prefHeight="56.0" prefWidth="110.0" style="-fx-background-color: transparent; -fx-text-fill: #cdd6f4; -fx-font-size: 13px; -fx-font-family: 'Segoe UI';" text="Friends">
                     <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image><Image url="@../../Images/People.png" /></image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button mnemonicParsing="false" prefHeight="56.0" prefWidth="110.0" style="-fx-background-color: transparent; -fx-text-fill: #cdd6f4; -fx-font-size: 13px; -fx-font-family: 'Segoe UI';" text="LdrBoard">
                     <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image><Image url="@../../Images/Leaderboard.png" /></image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button mnemonicParsing="false" prefHeight="56.0" prefWidth="110.0" style="-fx-background-color: transparent; -fx-text-fill: #cdd6f4; -fx-font-size: 13px; -fx-font-family: 'Segoe UI';" text="Settings">
                     <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image><Image url="@../../Images/Settings.png" /></image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button mnemonicParsing="false" prefHeight="56.0" prefWidth="110.0" style="-fx-background-color: transparent; -fx-text-fill: #cdd6f4; -fx-font-size: 13px; -fx-font-family: 'Segoe UI';" text="MyStats">
                     <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image><Image url="@../../Images/Statistics.png" /></image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button mnemonicParsing="false" prefHeight="56.0" prefWidth="100.0" style="-fx-background-color: transparent; -fx-text-fill: #cdd6f4; -fx-font-size: 13px; -fx-font-family: 'Segoe UI';" text="About">
                     <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image><Image url="@../../Images/About.png" /></image>
                        </ImageView>
                     </graphic>
                  </Button>
               </children>
            </HBox>
         </children>
      </AnchorPane>

      <!-- ══════════ STARTUP PANE ══════════ -->
      <Pane fx:id="startupPane" prefHeight="544.0" prefWidth="900.0" style="-fx-background-color: transparent;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="56.0">
         <children>
            <!-- Hero image centred -->
            <ImageView fx:id="WelcomeText" fitHeight="350.0" fitWidth="600.0" layoutX="235.0" layoutY="30.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../Images/Untitled-1.png" />
               </image>
            </ImageView>

            <!-- SIGN UP -->
            <Button fx:id="signUpButton" layoutX="260.0" layoutY="310.0" mnemonicParsing="false" onAction="#handleUser" prefHeight="50.0" prefWidth="150.0" style="-fx-background-color: #a6e3a1; -fx-text-fill: #1e1e2e;                            -fx-font-size: 15px; -fx-font-weight: bold;                            -fx-background-radius: 8; -fx-font-family: 'Segoe UI';" text="SIGN UP" />

            <!-- LOG IN -->
            <Button fx:id="logInButton" defaultButton="true" layoutX="490.0" layoutY="310.0" mnemonicParsing="false" onAction="#handleUser" prefHeight="50.0" prefWidth="150.0" style="-fx-background-color: #89b4fa; -fx-text-fill: #1e1e2e;                            -fx-font-size: 15px; -fx-font-weight: bold;                            -fx-background-radius: 8; -fx-font-family: 'Segoe UI';" text="LOG IN" />
         </children>
      </Pane>

      <!-- ══════════ USERNAME / DASHBOARD PANE ══════════ -->
      <Pane fx:id="usernamePane" prefHeight="300.0" prefWidth="500.0" style="-fx-background-color: #181825; -fx-background-radius: 12;                    -fx-border-color: #313244; -fx-border-radius: 12; -fx-border-width: 1;" AnchorPane.leftAnchor="200.0" AnchorPane.topAnchor="130.0">
         <children>
            <!-- Stats card content -->
            <VBox layoutX="24.0" layoutY="20.0" spacing="10.0">
               <children>
                  <Label fx:id="username" style="-fx-text-fill: #89b4fa; -fx-font-size: 22px; -fx-font-weight: bold; -fx-font-family: 'Cascadia Code';" text="&lt;USERNAME&gt;" />
                  <Label fx:id="wpm" style="-fx-text-fill: #a6e3a1; -fx-font-size: 16px; -fx-font-family: 'Cascadia Code';" text="WPM: " />
                  <Label fx:id="accuracy" style="-fx-text-fill: #fab387; -fx-font-size: 16px; -fx-font-family: 'Cascadia Code';" text="Accuracy: " />
               </children>
            </VBox>

            <!-- Action buttons -->
            <HBox layoutX="24.0" layoutY="160.0" spacing="16.0">
               <children>
                  <Button fx:id="test" mnemonicParsing="false" onAction="#actionButton" prefHeight="48.0" prefWidth="130.0" style="-fx-background-color: #89b4fa; -fx-text-fill: #1e1e2e;                                  -fx-font-size: 15px; -fx-font-weight: bold;                                  -fx-background-radius: 8; -fx-font-family: 'Cascadia Code';" text="TEST" />
                  <Button fx:id="race" mnemonicParsing="false" onAction="#actionButton" prefHeight="48.0" prefWidth="130.0" style="-fx-background-color: #a6e3a1; -fx-text-fill: #1e1e2e;                                  -fx-font-size: 15px; -fx-font-weight: bold;                                  -fx-background-radius: 8; -fx-font-family: 'Cascadia Code';" text="RACE" />
               </children>
            </HBox>

            <!-- Logout -->
            <Button fx:id="race1" layoutX="370.0" layoutY="248.0" mnemonicParsing="false" onAction="#actionButton" prefHeight="38.0" prefWidth="106.0" style="-fx-background-color: #f38ba8; -fx-text-fill: #1e1e2e;                            -fx-font-size: 13px; -fx-font-weight: bold;                            -fx-background-radius: 8; -fx-font-family: 'Cascadia Code';" text="LOGOUT" />
         </children>
      </Pane>

                              <!-- ══════════ TYPING PANE ══════════ -->
      <Pane fx:id="typingPane" prefHeight="544.0" prefWidth="900.0" style="-fx-background-color: #1e1e2e;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="56.0">
         <children>

                                    <!-- WPM label -->
            <Label fx:id="wpmLabel" layoutX="390.0" layoutY="80.0" prefHeight="44.0" prefWidth="120.0" style="-fx-text-fill: #fab387; -fx-font-size: 24px;                           -fx-font-weight: bold; -fx-font-family: 'Cascadia Code';" text="WPM: " />

                                    <!-- Typing block container -->
            <VBox layoutX="80.0" layoutY="140.0" prefHeight="220.0" prefWidth="740.0" style="-fx-background-color: #181825; -fx-background-radius: 10;                          -fx-padding: 14;                          -fx-border-color: #313244; -fx-border-radius: 10; -fx-border-width: 1;">
               <children>
                  <TextFlow fx:id="typingBlock" prefHeight="190.0" prefWidth="712.0" />
               </children>
            </VBox>

                                    <!-- Input field -->
            <TextArea fx:id="currentWord" layoutX="310.0" layoutY="390.0" maxHeight="52.0" minHeight="52.0" prefHeight="52.0" prefWidth="280.0" style="-fx-control-inner-background: #313244; -fx-text-fill: #cdd6f4;                              -fx-font-size: 18px; -fx-background-radius: 8;                              -fx-font-family: monospace;                              -fx-border-color: #585b70; -fx-border-radius: 8;">
               <font>
                  <Font name="Segoe UI" size="18.0" />
               </font>
            </TextArea>

                                    <!-- Stop button -->
            <Button fx:id="stopButton" layoutX="396.0" layoutY="462.0" mnemonicParsing="false" onAction="#actionButton" prefHeight="44.0" prefWidth="108.0" style="-fx-background-color: #f38ba8; -fx-text-fill: #1e1e2e;                            -fx-font-size: 15px; -fx-font-weight: bold;                            -fx-background-radius: 8; -fx-font-family: 'Segoe UI';" text="STOP" />
         </children>
      </Pane>

   </children>
</AnchorPane>
